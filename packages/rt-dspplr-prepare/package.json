{
  "name": "@saitdigital/rt-dspplr-prepare",
  "version": "0.1.0",
  "author": "eightraw (SAIT Digital)",
  "homepage": "https://github.com/eightraw/rt-dspplr/tree/main/packages/rt-dspplr-prepare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eightraw/rt-dspplr.git",
    "directory": "packages/rt-dspplr-prepare"
  },
  "bugs": {
    "url": "https://github.com/eightraw/rt-dspplr/issues"
  },
  "description": "Node-side preparation of long recordings for the RT-DSPPLR web audio player: segments, overview peaks, bands, spectrogram and named stems under one manifest. CLI and API.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "audio",
    "waveform",
    "peaks",
    "spectrogram",
    "segments",
    "manifest",
    "long-audio",
    "rt-dspplr"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rtd-prepare": "bin/rtd-prepare.mjs"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build/test-node.mjs",
    "prepack": "npm run build",
    "test:package": "node build/test-package.mjs"
  },
  "dependencies": {
    "@saitdigital/rt-dspplr": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.6.2"
  }
}
